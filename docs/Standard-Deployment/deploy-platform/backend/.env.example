# Openfire 部署管理平台后端环境变量模板
# 复制为 .env 后填写实际值

# 部署目录（存放生成的 docker-compose 文件与数据卷）
COMPOSE_DIR=/opt/deploy

# 默认规模（small / medium / large / custom）
SCALE=small

# Openfire 配置
OPENFIRE_IMAGE=openfire-openfire:5.1.2
OPENFIRE_DOMAIN=xmpp.collab.local
OPENFIRE_MEMORY=1g

# 端口
OPENFIRE_ADMIN_PORT=19090
OPENFIRE_C2S_TLS_PORT=15223
OPENFIRE_WS_PORT=17443

# 数据库
OPENFIRE_DB_PASSWORD=change-me

# 备份目录（本地）
BACKUP_DIR=/opt/backup
