      "id": 100,
      "title": "① IM 服务健康（端到端探针）",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "afysmv31mxx4wf"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 101,
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "im_login_success",
          "legendFormat": "1=正常 0=失败",
          "refId": "A"
        }
      ],
      "title": "IM 登录成功率",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "afysmv31mxx4wf"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "smooth",
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 18,
        "x": 6,
        "y": 1
      },
      "id": 102,
      "targets": [
        {
          "expr": "im_login_latency_seconds",
          "legendFormat": "登录耗时(秒)",
          "refId": "A"
        }
      ],
      "title": "IM 登录延迟",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
