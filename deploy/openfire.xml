<?xml version="1.0" encoding="UTF-8"?>
<!--
  Openfire 5.1.2 预置配置 — 独立 postgres 实例（openfire 库，故障隔离）
  · 数据库：org.postgresql.Driver → jdbc:postgresql://openfire-db:5432/openfire
  · 账号：openfire / 密码为【明文占位符 change-me-db-password】，部署时必须与 .env 的 OPENFIRE_DB_PASSWORD 改成同一强密码
  · XMPP 域：xmpp.collab.local
  · <setup>true</setup>：跳过 setup 向导，直接连接数据库
-->
<jive>
  <adminConsole>
    <port>9090</port>
    <securePort>9091</securePort>
  </adminConsole>
  <locale>zh_CN</locale>
  <connectionProvider>
    <className>org.jivesoftware.database.DefaultConnectionProvider</className>
  </connectionProvider>
  <database>
    <defaultProvider>
      <driver>org.postgresql.Driver</driver>
      <serverURL>jdbc:postgresql://openfire-db:5432/openfire</serverURL>
      <username>openfire</username>
      <password>change-me-db-password</password>
      <testSQL>select 1</testSQL>
      <testBeforeUse>false</testBeforeUse>
      <testAfterUse>false</testAfterUse>
      <testTimeout>PT0.5S</testTimeout>
      <timeBetweenEvictionRuns>PT30S</timeBetweenEvictionRuns>
      <minIdleTime>PT15M</minIdleTime>
      <maxWaitTime>PT0.5S</maxWaitTime>
      <minConnections>5</minConnections>
      <maxConnections>25</maxConnections>
      <connectionTimeout>1.0</connectionTimeout>
    </defaultProvider>
  </database>
  <setup>true</setup>
  <fqdn>xmpp.collab.local</fqdn>
</jive>
