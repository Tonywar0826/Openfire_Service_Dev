# =============================================================
# .env 模板 — 复制为 .env 后【必须修改】所有密码再启动
#   cp .env.example .env && vim .env
# =============================================================

# 时区
TZ=Asia/Shanghai

# ---- PostgreSQL ----
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_USER=collab
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=collaboration
POSTGRES_PORT=5432
# M0-2：专用应用账号（collab_app，非超级用户，Alembic/运行时使用）
COLLAB_APP_PASSWORD=change-me-strong-password

# ---- Redis ----
REDIS_IMAGE=redis:7-alpine
REDIS_PORT=6379

# ---- RabbitMQ ----
RABBITMQ_IMAGE=rabbitmq:3.13-management-alpine
RABBITMQ_USER=collab
RABBITMQ_PASSWORD=change-me-strong-password
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ---- MinIO ----
MINIO_IMAGE=minio/minio:latest
MINIO_ROOT_USER=collabadmin
MINIO_ROOT_PASSWORD=change-me-strong-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
