# =============================================================
# Openfire 服务 .env 模板 — 复制为 .env 后【必须修改】密码再启动
#   cp .env.example .env && vim .env
# =============================================================

# 时区
TZ=Asia/Shanghai

# ---- Openfire 数据库（独立 postgres 实例，故障隔离）----
POSTGRES_IMAGE=postgres:16-alpine
OPENFIRE_USER=openfire
OPENFIRE_DB_PASSWORD=change-me-db-password   # ★ 必填：数据库密码（与 openfire.xml 里 <password> 改成同一个强密码）
OPENFIRE_DB=openfire
OPENFIRE_DB_PORT=25432

# ---- Openfire 引擎 ----
OPENFIRE_IMAGE=openfire-openfire:5.1.2
OPENFIRE_ADMIN_PORT=19090       # 管理台（仅本机 127.0.0.1 访问）
OPENFIRE_C2S_TLS_PORT=15223     # XMPP c2s（TLS）
OPENFIRE_WS_PORT=17443          # WebSocket

# ---- coturn 音视频中继 ----
COTURN_IMAGE=coturn/coturn:latest
